{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "devUrl": "http://localhost:1421",
    "frontendDist": "../dist/windows",
    "beforeDevCommand": "pnpm dev:windows",
    "beforeBuildCommand": "pnpm build:windows"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YT Downloader",
        "width": 480,
        "height": 720,
        "minWidth": 420,
        "minHeight": 560,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ]
  },
  "bundle": {
    "targets": ["nsis", "msi"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"]
      }
    }
  }
}
