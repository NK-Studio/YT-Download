{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist/macos",
    "beforeDevCommand": "pnpm dev:macos",
    "beforeBuildCommand": "pnpm build:macos"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YT Downloader",
        "width": 480,
        "height": 700,
        "minWidth": 420,
        "minHeight": 560,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": true,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": ["sidebar"],
          "state": "followsWindowActiveState"
        }
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
